<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_po_line_stock" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.po_line_available_stock</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Flags read by the lines' column_invisible attrs -->
            <field name="partner_id" position="after">
                <field name="pls_show_on_hand" invisible="1"/>
                <field name="pls_show_forecast" invisible="1"/>
            </field>

            <!-- Editable list of lines -->
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_qty']" position="after">
                <field name="pls_is_storable" invisible="1"/>
                <field name="pls_qty_on_hand"
                       class="o_pls_stock"
                       optional="show"
                       decoration-danger="pls_qty_on_hand &lt; 0"
                       decoration-muted="pls_qty_on_hand == 0"
                       attrs="{'column_invisible': [('parent.pls_show_on_hand', '=', False)],
                               'invisible': [('pls_is_storable', '=', False)]}"/>
                <field name="pls_qty_forecasted"
                       class="o_pls_stock"
                       optional="show"
                       decoration-danger="pls_qty_forecasted &lt; 0"
                       decoration-warning="pls_qty_forecasted &gt;= 0 and pls_qty_forecasted &lt; product_qty"
                       attrs="{'column_invisible': [('parent.pls_show_forecast', '=', False)],
                               'invisible': [('pls_is_storable', '=', False)]}"/>
            </xpath>

            <!-- Line form (used on mobile / when opening a line) -->
            <xpath expr="//field[@name='order_line']/form//field[@name='product_qty']/.." position="after">
                <field name="pls_is_storable" invisible="1"/>
                <field name="pls_qty_on_hand"
                       attrs="{'invisible': ['|', ('parent.pls_show_on_hand', '=', False), ('pls_is_storable', '=', False)]}"/>
                <field name="pls_qty_forecasted"
                       attrs="{'invisible': ['|', ('parent.pls_show_forecast', '=', False), ('pls_is_storable', '=', False)]}"/>
            </xpath>
        </field>
    </record>
</odoo>
